{
  "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  "extends": ["./base.json"],
  "files": {
    "includes": ["**", "!node_modules", "!.next", "!dist", "!build", "!out"]
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noDocumentCookie": "off",
        "noUnknownAtRules": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn"
      },
      "nursery": {
        "useSortedClasses": "error"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  }
}
